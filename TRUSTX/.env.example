# TrustX Environment Configuration Template
# Copy to .env and adjust for local development
# NEVER commit real secrets to version control

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================
GATEWAY_CONFIG=./gateway/config/gateway.yaml
GATEWAY_CA_CERT=./gateway/certs/ca.crt
GATEWAY_CA_KEY=./gateway/certs/ca.key
GATEWAY_SERVER_CERT=./gateway/certs/gateway.crt
GATEWAY_SERVER_KEY=./gateway/certs/gateway.key
AUDIT_LOG_PATH=./audit/audit.log
POLICY_PATH=./gateway/config/policy.yaml

# Upstream domain service URLs (used by gateway for routing)
RED_TEAM_URL=https://red-team:8001
TARGET_URL=https://target:8002
BLUE_TEAM_URL=https://blue-team:8003

# =============================================================================
# DOMAIN SERVICE CONFIGURATION (Red, Target, Blue)
# =============================================================================
# Each domain gets its own client certificate for mTLS auth to gateway
DOMAIN=red                    # red | target | blue
SERVICE_PORT=8001             # 8001=red, 8002=target, 8003=blue
GATEWAY_CA_CERT=./gateway/certs/ca.crt
CLIENT_CERT=./red-team/certs/red.crt
CLIENT_KEY=./red-team/certs/red.key
AUDIT_LOG_PATH=./audit/audit.log

# =============================================================================
# UI CONFIGURATION
# =============================================================================
VITE_GATEWAY_URL=https://localhost:8443

# =============================================================================
# DEVELOPMENT OVERRIDES (optional)
# =============================================================================
# LOG_LEVEL=debug
# SKIP_CERT_VERIFY=true       # Only for local dev without proper certs
# DEV_MODE=true

# =============================================================================
# AUTHENTICATION (REQUIRED - generate with: openssl rand -hex 32)
# =============================================================================
TRUSTX_SECRET_KEY=change-me-generate-a-secure-32-byte-hex-value